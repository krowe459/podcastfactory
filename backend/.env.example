# --- LLM [TEAM DECISION: confirm provider, key holder, and budget] ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Effort per agent: low | medium | high | xhigh | max
PRODUCER_EFFORT=high
HOST_EFFORT=medium
# Server-side refusal fallback: "default" (API picks the fallback model) or "off"
ANTHROPIC_FALLBACKS=default

# --- Pipeline ---
WORDS_PER_MINUTE=150
DURATION_TOLERANCE=0.10
MAX_REVISIONS=2
MAX_SOURCE_CHARS=120000
CHUNK_CHARS=30000
MAX_TURNS_PER_SECTION=30
INCLUDE_SOURCE_IN_HOST_CONTEXT=true
MAX_UPLOAD_MB=25

# --- Content [TEAM DECISIONS] ---
COURSE_NAME=Executive MBA program
# Host first names; leave both empty to keep "Host A" / "Host B"
HOST_A_NAME=
HOST_B_NAME=
# Close with "This episode is a guide to the reading; the source holds more nuance."
INCLUDE_CLOSING_DISCLAIMER=true

# --- Audio [TEAM DECISION: TTS vendor and voice ids] ---
TTS_PROVIDER=stub
VOICE_MAP={"A": "stub-voice-a", "B": "stub-voice-b"}

# --- Server ---
CORS_ORIGINS=http://localhost:3000
# OUTPUT_DIR=./output
